# ============================================================
# ET_Mini_Militia — Git ignore policy
# ------------------------------------------------------------
# reference/ : extracted/decompiled contents of the commercial
#              Mini Militia XAPK. Copyrighted material — never
#              redistribute. Kept local for study only.
# tools/     : third-party binaries (apktool.jar, jadx) and the LAN
#              relay server. The Cocos Creator editor itself is NOT
#              bundled anymore — install it via Cocos Dashboard.
# ============================================================

# --- copyrighted reference material (never publish) ---
reference/

# --- heavy toolchain binaries ---
tools/*
!tools/tsc-check/
!tools/lan-relay.mjs

# --- npm dependencies (tsc-check) ---
# tools/tsc-check/ is whitelisted above, so re-ignore its installed deps;
# package.json + package-lock.json remain tracked for reproducible installs.
tools/tsc-check/node_modules/

# --- Cocos Creator generated working files ---
game/temp/
game/library/
game/build/
game/local/
game/profiles/
game/extensions/

# --- OS / editor cruft ---
Thumbs.db
Desktop.ini
.DS_Store
*.log

# --- archives ---
*.zip
*.xapk
*.apk

# --- Gradle / Native build caches ---
.gradle/
**/build/

